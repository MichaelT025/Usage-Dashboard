{
  "name": "llm-usage",
  "version": "0.1.0",
  "description": "Local web dashboard for LLM subscription usage (Claude, Codex, OpenCode Go)",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "llm-usage": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-public.mjs",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.6",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
